<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Debian Setup" Height="620" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="SwitchOnBrush" Color="#005A9E"/>
        <SolidColorBrush x:Key="SwitchOffBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="SwitchThumbBrush" Color="White"/>
        <SolidColorBrush x:Key="SwitchDisabledBrush" Color="#E0E0E0"/>
        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Opacity="1">
                            <Border x:Name="SwitchTrack" CornerRadius="11"
                                    Background="{StaticResource SwitchOffBrush}"
                                    Width="42" Height="22" Margin="0,0,10,0">
                                <Border x:Name="SwitchThumb" CornerRadius="9"
                                        Background="{StaticResource SwitchThumbBrush}"
                                        Width="18" Height="18"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background"
                                        Value="{StaticResource SwitchOnBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin"
                                        Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Background"
                                        Value="{StaticResource SwitchDisabledBrush}"/>
                                <Setter TargetName="ContentSite" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Menu" x:Key="AppMenu">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="mnuMain" DockPanel.Dock="Top" Style="{StaticResource AppMenu}">
            <MenuItem x:Name="mnuFile" Header="Datei">
                <MenuItem x:Name="mnuStartWindowsSetup" Header="Windows Client Setup öffnen"/>
                <Separator/>
                <MenuItem x:Name="mnuSetPassword" Header="sudo-Passwort speichern"/>
                <Separator/>
                <MenuItem x:Name="mnuInstallSelected" Header="Alle nicht-installierten installieren"/>
                <Separator/>
                <MenuItem x:Name="mnuBeenden" Header="Beenden"/>
            </MenuItem>
            <MenuItem x:Name="mnuAbout" Header="Über">
                <MenuItem x:Name="mnuVersion" Header="Version"/>
            </MenuItem>
        </Menu>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="WSL Debian Setup"
                           FontSize="18" FontWeight="Bold" Margin="0,5,0,10" Foreground="#005A9E"/>
            </Grid>

            <TabControl x:Name="tabMain" Grid.Row="1"/>

            <StackPanel x:Name="statusPanel" Grid.Row="2" Margin="0,5,0,0">
                <RichTextBox x:Name="txtStatus" IsReadOnly="True" Height="120"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="#F5F5F5" BorderBrush="#CCCCCC"
                             FontFamily="Consolas" FontSize="11">
                    <FlowDocument PagePadding="0"/>
                </RichTextBox>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="txtPasswordHint" Foreground="#FFA500" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="Kein sudo-Passwort gespeichert – Installation/Deinstallation nicht möglich. Menü: Datei → sudo-Passwort speichern"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>